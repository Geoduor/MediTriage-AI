# =============================================================================
# MediTriage AI - environment template
# Copy to `.env` for local backend dev:  copy .env.example .env
# Never commit the real `.env`.
# =============================================================================

# --- LLM provider (optional) ---------------------------------------------------
# The LLM is an enhancement layer ONLY - triage decisions come from the
# deterministic rule engine and never depend on any API. Leave everything here
# blank and the system still works fully offline.
#
# Recommended for the hackathon: gemini (free tier, no credit card, hosted API,
# strongest Swahili of the free options).
LLM_PROVIDER=gemini            # gemini | groq | ollama | anthropic | none

# --- Gemini (Google AI Studio) - RECOMMENDED ----------------------------------
# Get a free key at https://aistudio.google.com/apikey (sign in with Google,
# "Get API Key" - no billing required).
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash-preview

# --- Alternatives --------------------------------------------------------------
# Groq: fast, free, but tighter rate limits and weaker Swahili than Gemini.
#   LLM_PROVIDER=groq
#   GROQ_API_KEY=                 https://console.groq.com/keys
#   LLM_MODEL=llama-3.3-70b-versatile
#
# Ollama: fully offline, no key. Only works when the backend runs on the same
# machine as Ollama (it cannot power a Render deployment - use it for the
# recorded demo video if there is no internet).
#   LLM_PROVIDER=ollama
#   OLLAMA_BASE_URL=http://localhost:11434
#   LLM_MODEL=llama3.2
#
# Anthropic: the original provider, kept for flexibility.
#   LLM_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=
#   LLM_MODEL=claude-haiku-4-5-20251001

# auto  -> use the LLM when configured, otherwise deterministic
# on    -> require the LLM (raises if unavailable)
# off   -> never call any LLM (fully deterministic; safest for a live demo)
LLM_MODE=auto

# Per-request timeout in seconds. The <30s product requirement is enforced in
# the orchestrator, not by hoping the network is fast.
LLM_TIMEOUT_SECONDS=20

# --- App ---------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated. Add your deployed Vercel URL before going live.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend (Next.js) - used by frontend/.env.local -------------------------
# NEXT_PUBLIC_API_URL=http://localhost:8000
